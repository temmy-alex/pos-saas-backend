APP_NAME=POS SaaS Backend
APP_ENV=production
APP_PORT=8080
APP_DEBUG=false
APP_BASE_URL=https://api.yourdomain.com

GIN_MODE=release

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pos_saas_db
DB_USERNAME=pos_user
DB_PASSWORD=pos_password
DB_SSLMODE=disable

JWT_SECRET=change_this_to_long_random_secret_min_32_chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60